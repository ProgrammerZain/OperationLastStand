[ext_resource type="AudioStream" path="res://assets/audio/sfx/ui_click.wav" id="3_click"]

[node name="VictoryScreen" type="Control"]
process_mode = 3
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
